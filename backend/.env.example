DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthnexus
GEMINI_API_KEYS=key1,key2

# --- Authentication (required to start the API) ---
# Signs the 15-minute access tokens. At least 32 characters, unique per environment.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Mark the hn_refresh cookie Secure. False so it works over plain http in development; True in production (https).
COOKIE_SECURE=false
# Where the links in verification / password-reset emails point.
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API directly, comma-separated. Not needed through the Vite proxy.
CORS_ORIGINS=http://localhost:5173
# Token lifetimes. The signing algorithm is fixed at HS256 in code and is not
# read from here, so that no environment can weaken it.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Email ---
# Leave SMTP_HOST empty in development: every message is printed to the API's console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HealthNexus <no-reply@healthnexus.local>
SMTP_STARTTLS=true
# Flagged-reading and visit emails follow each person's choices in Settings > Preferences.
# One reading reminder per quiet stretch (3+ days without a reading), sent 9:00-20:00 India time.
READING_REMINDERS=true
# DBSCAN outbreak clustering over the last 14 days, every 6 hours.
OUTBREAK_CLUSTERING=true

# --- PHC verification documents ---
# Stored here, never served publicly. OCR needs the Tesseract program
# (https://github.com/UB-Mannheim/tesseract/wiki on Windows); without it documents go to manual review.
PRIVATE_UPLOAD_DIR=private_uploads
TESSERACT_CMD=

# Seed scripts (python -m app.seeds.<name>)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
PHC_WORKER_EMAIL=phc.worker@example.com
PHC_WORKER_PASSWORD=
DEMO_CITIZEN_PASSWORD=
