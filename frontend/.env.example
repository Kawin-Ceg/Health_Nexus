# Both are optional. In development the Vite dev server proxies /api to the backend,
# so the app and API share one origin and the httpOnly refresh cookie just works.

# Where the dev-server proxy sends /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Only for a build served from a different origin than the API. Leave unset to use /api/v1.
# Cross-origin also needs CORS_ORIGINS set on the backend and, in production, COOKIE_SECURE=true.
# VITE_API_URL=https://api.example.com/api/v1
